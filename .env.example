# PORT: Server port configuration (defaults to 3000)
PORT=3000

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VERCEL_TOKEN: Optional Vercel API token for automated Vercel deployments.
# Users can also provide their personal Vercel Token in the UI during 1-click deploy.
VERCEL_TOKEN="MY_VERCEL_TOKEN"

# STRIPE_SECRET_KEY: Secret key for Stripe payment processing
STRIPE_SECRET_KEY="sk_test_..."

# STRIPE_WEBHOOK_SECRET: Secret for validating Stripe Webhook signatures
STRIPE_WEBHOOK_SECRET="whsec_..."

# VITE_STRIPE_PUBLIC_KEY: Public key for Stripe client initialization
VITE_STRIPE_PUBLIC_KEY="pk_test_..."
